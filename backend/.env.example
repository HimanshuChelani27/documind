# Copy to backend/.env. Everything is optional: with no keys DocuMind runs in extractive mode.

# Any ONE of these turns on LLM-written answers and LLM-judge metrics (first one set wins,
# in this order). Groq and Gemini both have free tiers.
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=
# GROQ_API_KEY=
# OPENAI_API_KEY=
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com
# AZURE_OPENAI_DEPLOYMENT=<deployment name>

# Force a provider (anthropic | google | groq | openai | azure | ollama | extractive) or model.
# DOCUMIND_LLM_PROVIDER=ollama
# DOCUMIND_LLM_MODEL=llama3.2
# DOCUMIND_OLLAMA_URL=http://localhost:11434/v1

# Deployment
# DOCUMIND_CORS_ORIGINS=["https://your-frontend.example"]
# DOCUMIND_MODEL_THREADS=1
# DOCUMIND_MODEL_CACHE_DIR=models
